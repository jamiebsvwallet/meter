# Production Environment Configuration
# Copy this to .env.production and update values for your production environment

# Database Configuration (Update with your production MongoDB)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/plumbing-prod

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend Configuration
FRONTEND_URL=https://yourdomain.com

# Blockchain Configuration (Use mainnet in production)
BSV_NETWORK=mainnet

# Authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=use-a-secure-random-string-in-production

# Logging
LOG_LEVEL=warn

# CORS (Update with your actual domain)
CORS_ORIGIN=https://yourdomain.com

# API Documentation
API_VERSION=1.0.0
API_TITLE=Plumbing IoT BSV Platform

# Performance & Security
SESSION_TIMEOUT=3600
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=

# Email (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
